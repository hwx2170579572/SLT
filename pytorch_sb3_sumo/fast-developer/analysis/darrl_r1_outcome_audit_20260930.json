  "outcome_semantics": {
    "observed_issue": "success and collision are event flags, not mutually exclusive outcome labels. On a SUMO step where the ego is both arrived and colliding, both flags are true.",
    "source_evidence": [
      {
        "file": "Scene-Rep-Transformer-main/pytorch_sb3_sumo/envs/sumo/sumo_env.py",
        "lines": "1187-1194",
        "detail": "success is computed from ego arrival and collision independently from SUMO/geometric collision; no mutual-exclusion rule is applied."
      },
      {
        "file": "Scene-Rep-Transformer-main/pytorch_sb3_sumo/envs/sumo/sumo_env.py",
        "lines": "534, 546",
        "detail": "Raw reward is success minus collision; the transition terminates when either flag is true. A dual-flag step therefore has raw reward zero."
      },
      {
        "file": "Scene-Rep-Transformer-main/pytorch_sb3_sumo/algos/sb3_torch/evaluation.py",
        "lines": "216, 229, 261-262",
        "detail": "The evaluator stores success and collision separately and calculates both rates over the same episode denominator."
      },
      {
        "file": "Scene-Rep-Transformer-main/pytorch_sb3_sumo/fast-developer/train_intersection_yield_v2_d1.py",
        "lines": "803-806",
        "detail": "The D1 final-evaluation summary independently divides success and collision counts by n."
      },
      {
        "file": "Scene-Rep-Transformer-main/pytorch_sb3_sumo/fast-developer/reward_shaping_v2.py",
        "lines": "86-98",
        "detail": "Reward shaping assumes success/collision are mutually exclusive and uses success-first if/elif. For dual-flag training episodes, the observed event branch is reward_success=+10 and reward_collision=0."
      }
    ],
    "reporting_rule_used_for_exclusive_counts": "Collision takes precedence for offline mutually exclusive outcome counts; original success and collision event flags remain preserved in the source records. This recoding is descriptive only and does not repair the trained policy or its training targets."
  },
