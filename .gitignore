# ==== main1 顶层：只跟踪 Scene-Rep-Transformer-main/ 与顶层文档，其余 scratch/训练输出一律排除 ====
# 注意：所有目录规则都锚定到仓库根（前导 /），避免误伤 Scene-Rep-Transformer-main/ 内的嵌套目录。

# 训练输出 / 临时
/tmp/

# runs/：保留配置(json/xml/yaml)、脚本(py)、结果(md/csv/png)，仅排除模型与大诊断日志
# diagnostics/ 目录容纳全部原始日志(raw_steps.jsonl.gz/representation.jsonl/summary.json 等，15.3GB)；
# 另有 episodes/*.jsonl(43MB级) 散落在 diagnostics/ 之外，故同时排除 *.jsonl / *.jsonl.gz
/runs/**/diagnostics/
/runs/**/*.jsonl
/runs/**/*.jsonl.gz
/runs/**/*.zip
/runs/**/*.tmp
/runs/**/*.lock

# 第三方库拷贝 / 资产
/tf2rl-master/
/pt_asset/

# 备份 / 版本快照 / 草稿目录
/_*/
/tv411_*/
/t/
/t[0-9]*/

# 隐藏目录（.claude / .pytest_cache / .t45_* 等）
/.*/

# 日志
*.log
